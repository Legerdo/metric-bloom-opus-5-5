{
  "name": "metric-bloom",
  "private": true,
  "version": "1.0.0",
  "description": "Metric Bloom - a complete 2D pixel-art incremental game about social metrics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-pages.ps1",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "sim": "tsx scripts/balance.ts",
    "shots": "node scripts/screenshots.mjs",
    "playtest": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "galmuri": "2.40.3"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
